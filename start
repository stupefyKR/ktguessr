#!/bin/sh
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$app_dir/launcher.py" "$@"
fi
if command -v python >/dev/null 2>&1 && python -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
  exec python "$app_dir/launcher.py" "$@"
fi
printf '%s\n' 'Streetlens needs Python 3.8 or newer.' 'https://www.python.org/downloads/'
exit 1
